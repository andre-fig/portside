NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://portside:change-me@localhost:5432/portside?schema=public
PUBLIC_BASE_URL=https://api.example.invalid
ALLOWED_SOURCE_HOSTS=github.com,raw.githubusercontent.com,api.github.com,objects.githubusercontent.com
UPSTREAM_SIGNING_KEYS_JSON={}
PORTSIDE_ARTIFACT_HOSTS=downloads.example.invalid
PORTSIDE_APP_HOSTS=downloads.example.invalid
S3_ENDPOINT=https://storage.example.invalid
S3_REGION=auto
S3_BUCKET=portside-private
S3_ACCESS_KEY_ID=replace-in-railway
S3_SECRET_ACCESS_KEY=replace-in-railway
S3_FORCE_PATH_STYLE=true
SECONDARY_S3_ENDPOINT=https://backup-storage.example.invalid
SECONDARY_S3_REGION=auto
SECONDARY_S3_BUCKET=portside-secondary
SECONDARY_S3_ACCESS_KEY_ID=configure-in-railway
SECONDARY_S3_SECRET_ACCESS_KEY=configure-in-railway
SECONDARY_S3_FORCE_PATH_STYLE=true
ADMIN_BEARER_TOKEN=replace-with-a-long-railway-secret
LICENSE_HMAC_SECRET=replace-with-a-long-railway-secret
LICENSE_SIGNING_PRIVATE_KEY_PEM=replace-in-railway
LICENSE_SIGNING_PUBLIC_KEY_PEM=replace-in-railway
LICENSE_SIGNING_KEY_ID=license-2026-01
MANIFEST_SIGNING_PUBLIC_KEY=replace-with-base64-ed25519-public-key
MANIFEST_SIGNING_KEY_ID=manifest-2026-01
SPARKLE_PUBLIC_KEY=replace-with-base64-ed25519-public-key
OFFLINE_GRACE_DAYS=14
MAX_DOWNLOAD_BYTES=2147483648
PORTSIDE_GITHUB_REPOSITORY=andre-fig/portside
PORTSIDE_RUNTIME_WORKFLOW=build-runtime.yml
PORTSIDE_GITHUB_TOKEN=configure-in-railway
LOG_LEVEL=info
